rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────
    // Each user can only read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if resource.data.portfolioEnabled == true;
    }

    // ── Shared resources (educational links) ──────────────────────
    // Any authenticated user can read resources.
    // Only admin accounts can write/delete resources.
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Orders (resume review purchases) ─────────────────────────
    // Users can only create orders tagged with their own UID.
    // Users can only read/update their own orders.
    // Admins (role == 'admin') can read/update all orders for fulfilment.
    // Nobody can delete an order — orders are permanent payment records.
    match /orders/{orderId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow read, update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow delete: if false;
    }
  }
}
